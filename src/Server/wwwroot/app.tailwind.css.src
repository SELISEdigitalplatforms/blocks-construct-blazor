@import "tailwindcss";
@source "../Client/**/*.razor";
@source "../Components/**/*.razor";

@custom-variant dark (&:where(.dark, .dark *));

/* ── Design Tokens ──────────────────────────────────────────────────────── */
@theme {
	/* Font */
	--font-sans: 'Nunito Sans', ui-sans-serif, system-ui, sans-serif;

	/* Brand — Primary color scale (blue) */
	--color-primary-50:  #f0f4fb;
	--color-primary-100: #d9e6f5;
	--color-primary-200: #abc8eb;
	--color-primary-300: #75a8df;
	--color-primary-400: #4581c9;
	--color-primary-500: #2c5a9e;
	--color-primary-600: #254d86;
	--color-primary-700: #1c3b66;
	--color-primary-800: #132846;
	--color-primary-900: #0a1627;

	/* Brand — semantic shorthand mapped to login blue palette */
	--color-primary:            #2c5a9e;
	--color-primary-foreground: hsl(0 0% 100%);

	/* Semantic surfaces */
	--color-background:       hsl(0 0% 100%);
	--color-foreground:       hsl(240 10% 3.9%);
	--color-card:             hsl(0 0% 100%);
	--color-card-foreground:  hsl(240 10% 3.9%);
	--color-muted:            hsl(240 4.8% 95.9%);
	--color-muted-foreground: hsl(240 3.8% 46.1%);
	--color-border:           hsl(240 5.9% 90%);
	--color-input:            hsl(240 5.9% 90%);
	--color-ring:             #2c5a9e;
	--color-destructive:      hsl(0 84.2% 60.2%);

	/* Text emphasis hierarchy */
	--color-high-emphasis:   hsl(0 0% 6%);
	--color-medium-emphasis: hsl(0 0% 31%);
	--color-low-emphasis:    hsl(0 0% 62%);

	/* Status */
	--color-success:               hsl(142 72% 29%);
	--color-success-background:    hsl(142 72% 95%);
	--color-success-high-emphasis: hsl(142 72% 20%);
	--color-error:                 hsl(0 84.2% 60.2%);
	--color-error-background:      hsl(0 86% 97%);
	--color-warning:               hsl(32 95% 44%);
	--color-warning-background:    hsl(48 100% 89%);

	/* Border radius scale */
	--radius-sm:  0.25rem;
	--radius:     0.375rem;
	--radius-md:  0.375rem;
	--radius-lg:  0.5rem;
	--radius-xl:  0.75rem;
	--radius-2xl: 1rem;
}

/* ── Dark Mode Overrides ────────────────────────────────────────────────── */
/* Aligned to Tailwind's cool gray scale so `dark:bg-gray-*` classes and    */
/* semantic tokens render the same surface tone — no warm-vs-cool mismatch. */
.dark {
	--color-background:       #111827;   /* gray-900 */
	--color-foreground:       #f9fafb;   /* gray-50  */
	--color-card:             #1f2937;   /* gray-800 */
	--color-card-foreground:  #f9fafb;   /* gray-50  */
	--color-muted:            #374151;   /* gray-700 */
	--color-muted-foreground: #9ca3af;   /* gray-400 */
	--color-border:           #374151;   /* gray-700 */
	--color-input:            #374151;   /* gray-700 */
	--color-high-emphasis:    #ffffff;
	--color-medium-emphasis:  #d1d5db;   /* gray-300 */
	--color-low-emphasis:     #9ca3af;   /* gray-400 */
}

/* ── Base Styles ────────────────────────────────────────────────────────── */
@layer base {
	*, *::before, *::after {
		border-color: var(--color-border);
	}

	button,
	[role="button"],
	input[type="button"],
	input[type="submit"],
	input[type="reset"] {
		cursor: pointer;
	}

	body {
		font-family: var(--font-sans);
		background-color: var(--color-background);
		color: var(--color-foreground);
		-webkit-font-smoothing: antialiased;
	}

	input,
	select,
	textarea {
		background-color: var(--color-card);
		color: var(--color-high-emphasis);
		border-color: var(--color-input);
	}

	input::placeholder,
	textarea::placeholder {
		color: var(--color-medium-emphasis);
	}
}

/* ── Component Utilities ────────────────────────────────────────────────── */
@layer utilities {
	.form-input {
		@apply w-full rounded-md border border-input bg-card px-3 py-2 text-sm text-high-emphasis placeholder:text-medium-emphasis focus:outline-none focus:ring-2 focus:ring-primary;
	}
}

/* ── Animations ─────────────────────────────────────────────────────────── */
@keyframes slide-in-right {
	from { transform: translateX(100%); }
	to   { transform: translateX(0); }
}

.animate-slide-in-right {
	animation: slide-in-right 0.25s ease-out;
}
