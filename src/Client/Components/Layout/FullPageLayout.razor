@inherits LayoutComponentBase

@* Fixed chrome: language switcher + theme toggle on every full-page route *@
<div class="fixed top-4 right-4 z-50 flex items-center gap-2">
    <LanguageSwitcher @rendermode="InteractiveAuto" />
    <ThemeToggle @rendermode="@(new InteractiveAutoRenderMode(prerender: false))" />
</div>

@Body
